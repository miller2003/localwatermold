---
/**
 * PostHog analytics.
 *
 * All the new sites share one PostHog project and are told apart by $host
 * (plus the `site` super property). The project key is public by design: it
 * can only send events. It lives in src/data/analytics.json so the Worker's
 * /api/postback writes conversions to the same project. Empty key = nothing
 * is loaded and the site works exactly as before.
 *
 * Events:
 *   $pageview, $pageleave, autocapture   (SDK defaults)
 *   affiliate_link_click                 a real click on any /go/<slug>/ link
 *
 * Obvious automation (webdriver, headless UAs) never loads the SDK, so bots
 * don't inflate sessions. EA learned this after months of polluted numbers.
 */
import analytics from '../data/analytics.json';
const { posthogKey, posthogHost } = analytics;
---
{posthogKey && (
  <script is:inline define:vars={{ posthogKey, posthogHost }}>
    (function () {
      var nav = navigator, ua = nav.userAgent || '';
      if (nav.webdriver || /HeadlessChrome|PhantomJS|Lighthouse|bot\b|crawler|spider/i.test(ua)) return;
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(posthogKey, {
        api_host: posthogHost,
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
      });
      posthog.register({ site: location.hostname.replace(/^www\./, '') });

      // Capture phase, so this runs before any handler that rewrites the link.
      document.addEventListener('click', function (e) {
        if (!e.isTrusted) return;
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var u;
        try { u = new URL(a.getAttribute('href'), location.href); } catch (err) { return; }
        if (u.host !== location.host || u.pathname.indexOf('/go/') !== 0) return;
        var box = a.closest('[data-placement]') || a.closest('section[id], aside[id], [id]');
        posthog.capture('affiliate_link_click', {
          offer: u.pathname.split('/')[2] || '',
          path: location.pathname,
          cta_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 80),
          placement: a.getAttribute('data-placement') || (box && (box.getAttribute('data-placement') || box.id)) || '',
        }, { transport: 'sendBeacon' });
      }, true);
    })();
  </script>
)}
