---
import { pilotCounties, pct } from "../lib/data";
import { p } from "../lib/paths";

interface Props { metric?: "freeze" | "age" | "humid" | "heat" }
const { metric = "age" } = Astro.props;
const list = [...pilotCounties()].sort((a, b) => a.name.localeCompare(b.name));
const stat = (c: (typeof list)[number]) => {
  const w = c.weather!;
  if (metric === "freeze") return `${w.pipeRiskNights} freeze nights/yr`;
  if (metric === "humid") return `${w.muggyNights} muggy nights/yr`;
  if (metric === "heat") return `${pct(c.heatWoodPct + c.heatPropanePct)} wood or propane heat`;
  return `${pct(c.builtPre1980Pct)} built pre-1980`;
};
---
<ul class="county-grid">
  {list.map((c) => (
    <li>
      <a href={p(`/counties/${c.slug}/`)}>
        <span class="n">{c.short} County</span>
        <span class="s">{c.seat}</span>
        <span class="m">{stat(c)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .county-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; }
  .county-grid li { margin: 0; }
  .county-grid a { display: grid; gap: 2px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r); text-decoration: none; color: var(--ink); height: 100%; }
  .county-grid a:hover { border-color: var(--water); }
  .n { font-weight: 600; }
  .s { font-size: 0.86rem; color: var(--ink-2); }
  .m { font-size: 0.8rem; color: var(--ink-3); margin-top: 4px; }
</style>
