---
import { S } from "../lib/state";
// County vs. state county median, with rank, for the factors that drive water damage.
import { type County, STATE, allCounties, rank } from "../lib/data";

interface Props { c: County }
const { c } = Astro.props;
const w = c.weather!;
const all = allCounties();
const wx = all.filter((x) => x.weather);
const rowsRaw = [
  { label: "Homes built before 1960", v: c.builtPre1960Pct, m: STATE.builtPre1960Pct, unit: "%", r: rank(c, (x) => x.builtPre1960Pct, all) },
  { label: "Homes built before 1980", v: c.builtPre1980Pct, m: STATE.builtPre1980Pct, unit: "%", r: rank(c, (x) => x.builtPre1980Pct, all) },
  { label: "Homes built 2000 or later", v: c.built2000PlusPct, m: STATE.built2000PlusPct, unit: "%", r: rank(c, (x) => x.built2000PlusPct, all), better: true },
  { label: "Manufactured or mobile homes", v: c.mobileHomePct, m: STATE.mobileHomePct, unit: "%", r: rank(c, (x) => x.mobileHomePct, all) },
  { label: "Vacant homes", v: c.vacancyPct, m: STATE.vacancyPct, unit: "%", r: rank(c, (x) => x.vacancyPct, all) },
  { label: "Wood or propane heat", v: c.heatWoodPct + c.heatPropanePct, m: STATE.heatWoodPct + STATE.heatPropanePct, unit: "%", r: rank(c, (x) => x.heatWoodPct + x.heatPropanePct, all) },
  { label: "Nights at 20°F or colder", v: w.pipeRiskNights, m: STATE.weather.pipeRiskNights, unit: "/yr", r: rank(c, (x) => x.weather?.pipeRiskNights, wx) },
  { label: "Days with 1 inch+ of rain", v: w.heavyRainDays, m: STATE.weather.heavyRainDays, unit: "/yr", r: rank(c, (x) => x.weather?.heavyRainDays, wx) },
  { label: "Freeze-thaw days", v: w.freezeThawDays, m: STATE.weather.freezeThawDays, unit: "/yr", r: rank(c, (x) => x.weather?.freezeThawDays, wx) },
  { label: "Muggy nights (65°F+)", v: w.muggyNights, m: STATE.weather.muggyNights, unit: "/yr", r: rank(c, (x) => x.weather?.muggyNights, wx) },
];
const getters: Record<string, [(x: County) => number | undefined, County[]]> = {
  "Homes built before 1960": [(x) => x.builtPre1960Pct, all],
  "Homes built before 1980": [(x) => x.builtPre1980Pct, all],
  "Homes built 2000 or later": [(x) => x.built2000PlusPct, all],
  "Manufactured or mobile homes": [(x) => x.mobileHomePct, all],
  "Vacant homes": [(x) => x.vacancyPct, all],
  "Wood or propane heat": [(x) => x.heatWoodPct + x.heatPropanePct, all],
  "Nights at 20°F or colder": [(x) => x.weather?.pipeRiskNights, wx],
  "Days with 1 inch+ of rain": [(x) => x.weather?.heavyRainDays, wx],
  "Freeze-thaw days": [(x) => x.weather?.freezeThawDays, wx],
  "Muggy nights (65°F+)": [(x) => x.weather?.muggyNights, wx],
};
const rows = rowsRaw.map((r) => {
  const [get, pool] = getters[r.label];
  const vals = pool.map(get).filter((v): v is number => v !== undefined);
  return { ...r, max: Math.max(...vals), min: Math.min(...vals) };
});
const worse = (r: { v: number; m: number; better?: boolean }) => (r.better ? r.v < r.m * 0.95 : r.v > r.m * 1.05);
const better = (r: { v: number; m: number; better?: boolean }) => (r.better ? r.v > r.m * 1.05 : r.v < r.m * 0.95);
const fmt = (v: number) => (Math.abs(v) >= 10 ? Math.round(v).toString() : (Math.round(v * 10) / 10).toString());
// Scale each row from the lowest to the highest state county so differences are visible.
const bar = (v: number, lo: number, hi: number) => Math.max(3, Math.min(100, Math.round(((v - lo) / Math.max(hi - lo, 0.01)) * 100)));
---
<div class="table-wrap">
  <table class="cmp">
    <thead><tr><th>Factor</th><th>{c.short}</th><th>{S.name} median</th><th>Rank</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.label}</td>
          <td>
            <span class="v">{fmt(r.v)}{r.unit}</span>
            <span class="track" aria-hidden="true"><span class={`fill ${worse(r) ? "hi" : better(r) ? "lo" : ""}`} style={`width:${bar(r.v, r.min, r.max)}%`}></span><span class="mark" style={`left:${bar(r.m, r.min, r.max)}%`}></span></span>
          </td>
          <td class="faint">{fmt(r.m)}{r.unit}</td>
          <td class="faint">{r.r.rank} of {r.r.of}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="small faint">Rank 1 is the highest value. Bars run from the lowest to the highest {S.name} county; the tick marks the median; orange means higher water damage risk than the median, green means lower.</p>

<style>
  .cmp { width: 100%; border-collapse: collapse; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .cmp th, .cmp td { padding: 10px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  .cmp th { font-size: 0.8rem; color: var(--ink-2); font-weight: 600; }
  .cmp td:nth-child(2) { min-width: 170px; }
  .v { display: inline-block; min-width: 58px; font-weight: 600; }
  .track { display: inline-block; position: relative; width: 96px; height: 8px; border-radius: 4px; background: var(--sunk); vertical-align: middle; margin-left: 6px; }
  .fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background: var(--map-near); }
  .fill.hi { background: var(--signal); }
  .fill.lo { background: var(--sage); }
  .mark { position: absolute; top: -3px; width: 2px; height: 14px; background: var(--ink); margin-left: -1px; }
  @media (max-width: 560px) { .track { display: none; } .cmp td:nth-child(2) { min-width: 0; } }
</style>
