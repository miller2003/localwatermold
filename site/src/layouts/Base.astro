---
import { S, NATIONAL, ALL_STATES } from "../lib/state";
import "../styles/global.css";
import CallButton from "../components/CallButton.astro";
import Logo from "../components/Logo.astro";
import { SITE } from "../config";
import { p } from "../lib/paths";

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  county?: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  // "article" for guides: adds article meta tags. pageType sets the WebPage subtype in JSON-LD.
  ogType?: "website" | "article";
  pageType?: "WebPage" | "CollectionPage" | "FAQPage" | "AboutPage" | "ItemPage";
  modified?: string;
}
const { title, description, county, crumbs: pageCrumbs = [], schema = [], noindex, ogType = "website", pageType = "WebPage", modified = SITE.lastReviewed } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = SITE.launchMode !== "live" || noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const origin = Astro.site!.origin;

// Page crumbs are state-relative; state pages get the state as the first crumb after Home.
const crumbs: Crumb[] = NATIONAL
  ? pageCrumbs
  : [{ name: S.name, href: p("/") }, ...pageCrumbs.map((c) => ({ name: c.name, href: p(c.href) }))];
const ogImage = new URL(`/og-${NATIONAL ? "us" : S.key}.png`, Astro.site).href;
const ogAlt = NATIONAL ? `${SITE.brand}: ${SITE.tagline}` : `${SITE.brand} in ${S.name}: water damage, mold and fire help by county`;
const graph = [
  {
    "@type": "Organization",
    "@id": `${origin}/#org`,
    name: SITE.brand,
    alternateName: SITE.alternateNames,
    url: `${origin}/`,
    slogan: SITE.tagline,
    description: "An independent referral service that connects homeowners with local water damage, mold and fire restoration companies, and publishes county-level guidance built from Census and NOAA data. It does not perform restoration work.",
    // Keeps answer engines from merging us with restoration contractors that have similar names.
    disambiguatingDescription: `${SITE.brand} (${SITE.brandJoined}, ${SITE.domain}) is a U.S. homeowner information and referral website, not a restoration contractor or franchise. It is not affiliated with any restoration company whose name contains the words water, mold or fire.`,
    foundingDate: SITE.founded,
    ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
    mainEntityOfPage: `${origin}/about/`,
    logo: { "@type": "ImageObject", "@id": `${origin}/#logo`, url: `${origin}/logo.png`, contentUrl: `${origin}/logo.png`, width: 600, height: 600, caption: SITE.brand },
    image: { "@id": `${origin}/#logo` },
    email: SITE.contactEmail,
    contactPoint: { "@type": "ContactPoint", contactType: "customer support", email: SITE.contactEmail, availableLanguage: "English" },
    areaServed: { "@type": "Country", name: "United States" },
    knowsAbout: ["Water damage restoration", "Mold remediation", "Fire and smoke damage restoration", "Basement flooding", "Frozen pipes", "Homeowners insurance claims", "IICRC S500", "IICRC S520"],
    publishingPrinciples: `${origin}/editorial-policy/`,
  },
  {
    "@type": "WebSite",
    "@id": `${origin}/#site`,
    name: SITE.brand,
    // Google picks the site name shown above each result from here.
    alternateName: SITE.alternateNames,
    url: `${origin}/`,
    description: SITE.tagline,
    inLanguage: "en-US",
    publisher: { "@id": `${origin}/#org` },
  },
  {
    "@type": pageType,
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: "en-US",
    isPartOf: { "@id": `${origin}/#site` },
    about: { "@id": `${origin}/#org` },
    dateModified: modified,
    primaryImageOfPage: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630 },
    // The answer-first blocks that voice assistants and answer engines should read aloud or quote.
    speakable: { "@type": "SpeakableSpecification", cssSelector: ["h1", ".tldr", ".lede"] },
    ...(crumbs.length ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } } : {}),
  },
  ...(crumbs.length
    ? [{
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [{ name: "Home", href: "/" }, ...crumbs].map((c, i) => ({
          "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, origin).href,
        })),
      }]
    : []),
  ...schema,
];
const nav = NATIONAL
  ? [
      { href: "/#states", label: "Find your state" },
      { href: "/guides/", label: "Guides" },
      { href: "/water-damage-statistics/", label: "Risk by state" },
      { href: "/how-it-works/", label: "How it works" },
      { href: "/data-sources/", label: "Our data" },
    ]
  : [
      { href: p("/counties/"), label: "Counties" },
      { href: p("/water-damage/"), label: "Water damage" },
      { href: p("/mold-remediation/"), label: "Mold" },
      { href: p("/fire-smoke-damage/"), label: "Fire and smoke" },
      { href: p("/guides/"), label: "Guides" },
    ];
const path = Astro.url.pathname;
import Analytics from '../components/Analytics.astro';
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e151c" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  {ogType === "article" && <meta property="article:modified_time" content={modified} />}
  {ogType === "article" && <meta property="article:publisher" content={`${origin}/`} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <meta name="format-detection" content="telephone=no" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title={`${SITE.brand} summary for AI assistants`} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
  <link rel="api-catalog" href="/.well-known/api-catalog" />
  <link rel="service-doc" href="/developers/" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- WebMCP: the site's MCP tools for in-browser agents (worker/discovery.ts). -->
  <script src="/webmcp.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  <style>
    header.site { border-bottom: 1px solid var(--line); background: var(--paper); position: sticky; top: 0; z-index: 20; }
    .bar { display: flex; align-items: center; gap: 20px; min-height: 64px; }
    .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); flex: none; }
    .logo svg { display: block; height: 44px; width: auto; }
    .logo-state { font: 600 0.74rem/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding-left: 12px; border-left: 1px solid var(--line-2); white-space: nowrap; }
    .foot-logo svg { height: 72px; }
    nav.main { display: flex; gap: 4px; margin-left: auto; }
    nav.main a { white-space: nowrap; color: var(--ink-2); text-decoration: none; font-size: 0.95rem; padding: 8px 10px; border-radius: 8px; }
    nav.main a:hover, nav.main a[aria-current="page"] { color: var(--ink); background: var(--sunk); }
    .bar :global(.btn) { min-height: 42px; padding: 0 16px; font-size: 0.95rem; }
    .crumbs { font-size: 0.85rem; color: var(--ink-3); padding-top: 14px; }
    .crumbs a { color: var(--ink-2); text-decoration: none; }
    .crumbs a:hover { text-decoration: underline; }
    .crumbs span[aria-hidden] { margin: 0 6px; }
    footer.site { border-top: 1px solid var(--line); background: var(--sunk); margin-top: 0; padding: 48px 0 32px; font-size: 0.92rem; color: var(--ink-2); }
    footer.site a { color: var(--ink-2); }
    .foot-grid { display: grid; gap: 28px; grid-template-columns: 2fr repeat(3, 1fr); }
    .foot-grid h2 { font: 600 0.8rem/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 12px; }
    .foot-grid ul { list-style: none; padding: 0; margin: 0; }
    .foot-states { columns: 2; column-gap: 20px; }
    .legal { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 0.82rem; color: var(--ink-3); }
    .callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: var(--card); border-top: 1px solid var(--line-2); display: flex; gap: 8px; }
    .callbar :global(.btn) { flex: 1; min-height: 50px; }
    .callbar :global(.btn-ghost) { flex: 0 0 auto; }
    .preview-ribbon { background: var(--amber-soft); color: var(--amber-ink); font-size: 0.82rem; text-align: center; padding: 6px 12px; }
    @media (max-width: 1100px) { nav.main { display: none; } .bar :global(.btn) { margin-left: auto; } }
    @media (max-width: 960px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 760px) { .bar :global(.btn) { display: none; } }
    @media (max-width: 420px) { .bar .logo svg { height: 34px; } }
    @media (min-width: 761px) { .callbar { display: none; } }
  </style>
  <Analytics />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {SITE.launchMode !== "live" && <div class="preview-ribbon no-print">Preview build. Not indexed, and the call line isn't live yet.</div>}
  <header class="site">
    <div class="wrap bar">
      <a class="logo" href="/" aria-label={`${SITE.brand} home`}>
        <Logo height={44} />
        {!NATIONAL && <span class="logo-state">{S.name}</span>}
      </a>
      <nav class="main" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <CallButton county={county} placement="header" />
    </div>
  </header>
  {crumbs.length > 0 && (
    <div class="wrap crumbs no-print">
      <nav aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c, i) => (
          <><span aria-hidden="true">/</span>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</>
        ))}
      </nav>
    </div>
  )}
  <main id="main">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <a class="logo foot-logo" href="/" aria-label={`${SITE.brand} home`}><Logo variant="stacked" height={72} /></a>
          <p style="margin-top:14px;max-width:44ch"><strong>{SITE.tagline}.</strong> {SITE.brand} ({SITE.brandJoined}.com) is an independent referral service. When you call, you're connected with a participating restoration company that serves your area. We don't do restoration work, and we're not affiliated with any insurer or government agency.</p>
        </div>
        {NATIONAL ? (
          <div style="grid-column: span 2">
            <h2>States</h2>
            <ul class="foot-states">
              {[...ALL_STATES].sort((x, y) => x.name.localeCompare(y.name)).map((st) => <li><a href={`/${st.slug}/`}>{st.name}</a></li>)}
            </ul>
          </div>
        ) : (
          <>
            <div>
              <h2>{S.name} help</h2>
              <ul>
                <li><a href={p("/water-damage/")}>Water damage</a></li>
                <li><a href={p("/mold-remediation/")}>Mold remediation</a></li>
                <li><a href={p("/fire-smoke-damage/")}>Fire and smoke</a></li>
                <li><a href={p("/guides/basement-flooding-sump-pump/")}>Basement flooding</a></li>
                <li><a href={p("/basement-waterproofing/")}>Basement waterproofing</a></li>
                <li><a href={p("/counties/")}>All {S.name} counties</a></li>
                <li><a href="/#states">Other states</a></li>
              </ul>
            </div>
            <div>
              <h2>Guides and tools</h2>
              <ul>
                <li><a href={p("/guides/water-damage-first-hour/")}>The first hour</a></li>
                <li><a href={p(`/guides/${S.slug}-water-damage-insurance-claim/`)}>{S.name} insurance claims</a></li>
                <li><a href="/guides/does-homeowners-insurance-cover-water-damage/">Is it covered?</a></li>
                <li><a href={p("/tools/cost-estimator/")}>Cost estimator</a></li>
                <li><a href={p("/tools/emergency-checklist/")}>Printable checklist</a></li>
                <li><a href={p(`/${S.slug}-water-damage-risk/`)}>{S.name} risk index</a></li>
              </ul>
            </div>
          </>
        )}
        <div>
          <h2>Reference</h2>
          <ul>
            <li><a href="/guides/">All guides</a></li>
            <li><a href="/glossary/">Glossary</a></li>
            <li><a href="/water-damage-statistics/">Risk by state</a></li>
            <li><a href="/developers/">For AI agents</a></li>
          </ul>
          <h2 style="margin-top:24px">About</h2>
          <ul>
            <li><a href="/about/">About {SITE.brandJoined}</a></li>
            <li><a href="/how-it-works/">How it works</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/data-sources/">Data sources</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <p>If anyone is in danger, there's a gas smell, or water is near live electrical equipment, leave the building and call 911 first.</p>
        <p>Disclaimer: {SITE.brandJoined}.com is a free service to assist homeowners in connecting with local service providers. All contractors/providers are independent and {SITE.brandJoined}.com does not warrant or guarantee any work performed. It is the responsibility of the homeowner to verify that the hired contractor furnishes the necessary license and insurance required for the work being performed. All persons depicted in a photo or video are actors or models and not contractors listed on {SITE.brandJoined}.com.</p>
        <p style="margin:0">© {new Date().getFullYear()} {SITE.brand} · {SITE.brandJoined}.com. Information on this site is general guidance, not legal, insurance, or engineering advice.</p>
      </div>
    </div>
  </footer>
  <div class="callbar no-print">
    <CallButton county={county} placement="callbar" short />
    <a class="btn btn-ghost" href={NATIONAL ? "/#states" : p("/tools/emergency-checklist/")}>{NATIONAL ? "States" : "Checklist"}</a>
  </div>
  <script is:inline>
    document.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest("[data-call]");
      if (!a) return;
      var props = { placement: a.getAttribute("data-call"), county: a.getAttribute("data-county"), path: location.pathname };
      if (window.posthog && window.posthog.capture) window.posthog.capture("call_click", props);
      if (window.dataLayer) window.dataLayer.push(Object.assign({ event: "call_click" }, props));
    });
  </script>
</body>
</html>
