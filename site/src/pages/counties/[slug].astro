---
import { S, an } from "../../lib/state";
import Base from "../../layouts/Base.astro";
import CallButton from "../../components/CallButton.astro";
import Triage from "../../components/Triage.astro";
import CallPrep from "../../components/CallPrep.astro";
import StateMap from "../../components/StateMap.astro";
import MonthBars from "../../components/MonthBars.astro";
import BuiltBar from "../../components/BuiltBar.astro";
import CompareTable from "../../components/CompareTable.astro";
import Icon from "../../components/Icon.astro";
import { SITE, CALL_HOURS } from "../../config";
import { riskFor, riskLabel } from "../../lib/risk";
import { type County, pilotCounties, countyBySlug, META, STATE, int, pct, money, placeList } from "../../lib/data";
import { intro, housing, climate, mold, fire, topRisks, faqs, metaDescription, seasonCalendar, triageLocal, neighborContrast } from "../../lib/narrative";
import { p } from "../../lib/paths";

export function getStaticPaths() {
  return pilotCounties().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: County };
const w = c.weather!;
const risks = topRisks(c);
// The guide that answers each risk, so every county links to what matters most where it is.
const RISK_GUIDE: Record<string, { href: string; label: string }> = {
  freeze: { href: `/guides/frozen-pipes-${S.slug}/`, label: "Preventing frozen pipes" },
  mobile: { href: `/guides/frozen-pipes-${S.slug}/`, label: "Keeping lines from freezing" },
  age: { href: "/guides/signs-of-hidden-water-damage/", label: "Spotting hidden leaks" },
  rain: { href: "/basement-waterproofing/", label: "Basement waterproofing" },
  humid: { href: "/guides/mold-after-water-damage/", label: "Mold after water damage" },
  vacant: { href: "/guides/appliance-leaks/", label: "Shutoffs and leak sensors" },
  heat: { href: "/fire-smoke-damage/", label: "Fire and smoke damage" },
  thaw: { href: "/guides/ice-dams/", label: "Ice dams and ceiling leaks" },
};
const faq = faqs(c);
const cal = seasonCalendar(c);
const neighbors = c.adjacent.map((s) => countyBySlug(s)!).filter(Boolean);
const hours = CALL_HOURS.byCounty[c.slug] ?? CALL_HOURS.default;
const risk = riskFor(c.slug);
const origin = Astro.site!.origin;
const url = `${origin}${p(`/counties/${c.slug}/`)}`;

// Keyword first, then the county seat and the next-largest town while it fits in about 62 characters.
const titleBase = `Water Damage Restoration in ${c.short} County, ${S.abbr}`;
const towns = [c.seat, ...c.places.map((x) => x.name).filter((n) => n !== c.seat)].slice(0, 2);
const title = [`${titleBase} | ${towns.join(", ")}`, `${titleBase} | ${towns[0]}`, titleBase].find((t) => t.length <= 62) ?? titleBase;
const schema = [
  {
    "@type": "Service",
    "@id": `${url}#service`,
    name: `Water, mold and fire damage restoration referrals in ${c.name}, ${S.name}`,
    serviceType: "Water damage restoration referral",
    provider: { "@id": `${origin}/#org` },
    areaServed: {
      "@type": "AdministrativeArea",
      name: `${c.name}, ${S.name}`,
      containsPlace: c.places.slice(0, 8).map((p) => ({ "@type": "City", name: `${p.name}, ${S.abbr}` })),
    },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title={title} description={metaDescription(c)} county={c.slug} crumbs={[{ name: "Counties", href: "/counties/" }, { name: `${c.short} County`, href: `/counties/${c.slug}/` }]} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{c.short} County, {S.name} · {c.seat}</p>
        <h1>Water damage restoration in {c.short} County, {S.name}</h1>
        <p class="lede">Water spreading, a burst pipe, sewage, mold or smoke? Call to be connected with a restoration company that serves {placeList(c, 3)}. Start the steps below while you wait.</p>
        <div class="cta-row">
          <CallButton county={c.slug} placement="hero" label="Call" />
          <a class="btn btn-ghost" href="#start"><Icon name="arrow" />First steps</a>
        </div>
        <p class="small faint disclose" data-boilerplate>
          {hours === "24-7" ? "Answered 24/7 by a participating local provider." : CALL_HOURS.window ? `Answered ${CALL_HOURS.window} by a participating local provider. Outside those hours, start with the steps below.` : "Calls go to a participating local provider. Hours vary by area; if no one answers, start with the steps below."}
          {" "}We're a referral service and don't do the work ourselves. <a href="/how-it-works/">How it works</a>
        </p>
      </div>
      <aside class="card glance" aria-label={`${c.short} County at a glance`}>
        <StateMap focus={c.slug} title={`Map of ${S.name} with ${c.name} highlighted`} />
        <dl class="glance-list">
          <div><dt>Homes</dt><dd>{int(c.housingUnits)}</dd></div>
          <div><dt>Built before 1980</dt><dd>{pct(c.builtPre1980Pct)}</dd></div>
          <div><dt>Pipe-freeze nights / yr</dt><dd>{w.pipeRiskNights}</dd></div>
          <div><dt>Heavy-rain days / yr</dt><dd>{w.heavyRainDays}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="start">
    <div class="wrap">
      <p class="eyebrow">Start here</p>
      <h2>What's happening?</h2>
      <p class="muted read" data-boilerplate>Pick the closest match. These steps limit the damage and protect your insurance claim. Skip anything that isn't safe.</p>
      <Triage place={`your ${c.short} County home`} compact local={triageLocal(c)} />
    </div>
  </section>

  <section class="section" id="before-you-call" data-boilerplate>
    <div class="wrap">
      <p class="eyebrow">Before you call</p>
      <h2>What to ask a restoration company</h2>
      <CallPrep place={`${c.short} County`} compact />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Local risk profile</p>
      <h2>Why homes in {c.short} County get water damage</h2>
      <p class="muted read">{intro(c)}</p>
      {risk && (
        <a class="index-card" href={p(`/${S.slug}-water-damage-risk/`)}>
          <span class="index-score"><strong>{risk.score}</strong><span>/100</span></span>
          <span class="index-text">
            <strong>Water Damage Risk Index: {riskLabel(risk.score)}</strong>
            <span class="muted small">{c.short} County ranks {risk.rank} of {risk.of} {S.name} counties. See the statewide ranking and method.</span>
          </span>
        </a>
      )}
      <div class="grid grid-3 risks">
        {risks.map((r, i) => (
          <div class="risk">
            <span class="risk-n">{i + 1}</span>
            <h3>{r.title}</h3>
            <p class="muted">{r.detail}</p>
            {RISK_GUIDE[r.key] && <a class="risk-go small" data-boilerplate href={p(RISK_GUIDE[r.key].href)}>{RISK_GUIDE[r.key].label} →</a>}
          </div>
        ))}
      </div>
      <p class="small faint">The three factors where {c.short} County ranks highest compared with other {S.name} counties.</p>

      <div class="grid grid-2 climate">
        <div class="read prose">
          <h3>Weather</h3>
          {climate(c).map((p) => <p>{p}</p>)}
        </div>
        <div class="charts">
          <div class="card"><MonthBars values={w.monthlyFreeze} title={`Freezing nights per month, ${w.period} average`} unit="nights" tone="cold" decimals={0} /></div>
          <div class="card"><MonthBars values={w.monthlyHeavyRain} title={`Days with 1 inch or more of rain per month, ${w.period} average`} unit="days" decimals={1} /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Housing</p>
      <h2>What {c.short} County's homes are made of</h2>
      <div class="grid grid-2">
        <div class="read prose">
          {housing(c).map((p) => <p>{p}</p>)}
        </div>
        <div>
          <div class="card">
            <h3 style="font-size:1.05rem">Homes by year built</h3>
            <BuiltBar buckets={c.builtBuckets} name={c.name} />
          </div>
          <div class="grid grid-4" style="margin-top:16px">
            <div class="stat"><div class="stat-label">Owner-occupied</div><div class="stat-value">{pct(c.ownerPct)}</div><div class="stat-note">{S.name} median {pct(STATE.ownerPct)}</div></div>
            <div class="stat"><div class="stat-label">Single-family</div><div class="stat-value">{pct(c.singleFamilyPct)}</div><div class="stat-note">of all homes</div></div>
            {c.medianHomeValue ? <div class="stat"><div class="stat-label">Median home value</div><div class="stat-value">{money(c.medianHomeValue / 1000)}k</div><div class="stat-note">{S.name} median {money(STATE.medianHomeValue / 1000)}k</div></div> : null}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Beyond water</p>
      <h2>Mold and fire damage in {c.short} County</h2>
      <div class="grid grid-2">
        <article class="card">
          <h3><Icon name="mold" /> Mold</h3>
          <p class="muted">{mold(c)}</p>
          <a href={p("/mold-remediation/")}>Mold remediation: what to expect <Icon name="arrow" size={16} class="inline" /></a>
        </article>
        <article class="card">
          <h3><Icon name="flame" /> Fire and smoke</h3>
          <p class="muted">{fire(c)}</p>
          <a href={p("/fire-smoke-damage/")}>Fire and smoke cleanup: first steps <Icon name="arrow" size={16} class="inline" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <p class="eyebrow">Coverage</p>
        <h2>Communities served</h2>
        <p class="muted">Calls connect to restoration companies that work across {c.name}. The largest communities by population:</p>
        <ul class="places">
          {c.places.slice(0, 12).map((p) => <li><span>{p.name}</span><span class="faint">{int(p.population)}</span></li>)}
        </ul>
        <p class="small faint">Population from ACS {META.acsYears} 5-year estimates. Townships and unincorporated areas are covered too.</p>
      </div>
      <div>
        <p class="eyebrow">Nearby</p>
        <h2>Neighboring counties</h2>
        <p class="muted">{neighborContrast(c, neighbors)}</p>
        <ul class="neighbors">
          {neighbors.map((n) => (
            <li>{n.pilot ? <a href={p(`/counties/${n.slug}/`)}>{n.name}</a> : <span>{n.name}</span>}
              {n.pilot && n.weather && <span class="faint small">{pct(n.builtPre1980Pct)} pre-1980 · {n.weather.pipeRiskNights} freeze nights</span>}
            </li>
          ))}
        </ul>
        <div class="grid" style="margin-top:24px">
          <a class="card link-card" data-boilerplate href={p(`/guides/${S.slug}-water-damage-insurance-claim/`)}><Icon name="file" /><span><strong>Filing {an(S.name)} {S.name} insurance claim</strong><span class="muted small">What insurers must do, and by when</span></span></a>
          <a class="card link-card" data-boilerplate href={p("/tools/cost-estimator/")}><Icon name="dollar" /><span><strong>Estimate the cost</strong><span class="muted small">Typical ranges by water category</span></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">By the numbers</p>
      <h2>{c.short} County compared with {S.name}</h2>
      <div class="read"><CompareTable c={c} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap read">
      <p class="eyebrow">Questions</p>
      <h2>{c.short} County water damage FAQ</h2>
      {faq.map((f) => <details class="faq"><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </div>
  </section>

  <section class="section closing">
    <div class="wrap closing-grid">
      <div>
        <h2 data-boilerplate>Water won't wait. Neither should you.</h2>
        <p class="muted">Peak risk months in {c.short} County: freezing from {cal.freeze}, heavy rain in {cal.rain}.</p>
      </div>
      <CallButton county={c.slug} placement="closing" label="Call" />
    </div>
    <div class="wrap">
      <p class="small faint sources">
        Sources: U.S. Census Bureau, {META.acsRelease} estimates ({META.acsYears}); weather from {META.weatherSource}, {w.period}, averaged across the county; county boundaries from Census TIGER. Reviewed {SITE.lastReviewed}. <a href="/data-sources/">Methodology</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(28px, 5vw, 64px) 0 clamp(36px, 5vw, 64px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .glance :global(svg) { max-height: 300px; width: auto; margin: 0 auto; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 12px; }
  .disclose { max-width: 56ch; }
  .glance { padding: 18px; }
  .glance-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin: 16px 0 0; }
  .glance-list dt { font-size: 0.8rem; color: var(--ink-2); }
  .glance-list dd { margin: 2px 0 0; font: 600 1.35rem/1.15 var(--serif); }
  .risks { margin: 20px 0 10px; }
  .index-card { display: flex; align-items: center; gap: 18px; margin-top: 24px; padding: 16px 20px; background: var(--water-soft); color: var(--water-ink); border-radius: var(--r-lg); text-decoration: none; max-width: 640px; }
  .index-card:hover { text-decoration: none; box-shadow: inset 0 0 0 1px var(--water); }
  .index-score { display: flex; align-items: baseline; gap: 2px; font-family: var(--serif); }
  .index-score strong { font-size: 2.4rem; line-height: 1; }
  .index-score span { font-size: 1rem; opacity: 0.8; }
  .index-text { display: grid; gap: 2px; }
  .index-text .muted { color: var(--water-ink); opacity: 0.85; }
  .risk { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 20px 20px 16px 64px; }
  .risk-n { position: absolute; left: 20px; top: 20px; width: 30px; height: 30px; border-radius: 50%; background: var(--signal-soft); color: var(--signal-ink); display: grid; place-items: center; font-weight: 600; }
  .risk h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .risk p { margin: 0; font-size: 0.95rem; }
  .risk-go { display: inline-block; margin-top: 8px; }
  .climate { margin-top: 36px; align-items: start; }
  .charts { display: grid; gap: 16px; }
  .charts .card { padding: 18px 18px 14px; }
  article.card h3 { display: flex; align-items: center; gap: 10px; }
  .places { list-style: none; padding: 0; margin: 18px 0 12px; columns: 2; column-gap: 28px; }
  .places li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--line); break-inside: avoid; margin: 0; }
  .neighbors { list-style: none; padding: 0; margin: 18px 0 0; }
  .neighbors li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 10px 0; border-bottom: 1px solid var(--line); margin: 0; }
  .link-card { display: flex; gap: 14px; align-items: flex-start; text-decoration: none; color: var(--ink); padding: 18px; }
  .link-card:hover { border-color: var(--water); text-decoration: none; }
  .link-card > span { display: grid; gap: 2px; }
  :global(.inline) { display: inline; vertical-align: -3px; }
  .closing { background: var(--sunk); }
  .closing-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .closing h2 { margin-bottom: 6px; }
  .closing p { margin: 0; }
  .sources { max-width: 90ch; margin: 0; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .places { columns: 1; } }
</style>
