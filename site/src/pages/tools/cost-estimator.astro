---
import { S, an } from "../../lib/state";
import Base from "../../layouts/Base.astro";
import CallButton from "../../components/CallButton.astro";
import { p } from "../../lib/paths";
---
<Base
  title={`Water Damage Cost Estimator for ${S.name} Homes (2026 Ranges)`}
  description={`Estimate a water damage mitigation cost range for ${an(S.name)} ${S.name} home from the wet square footage and water category, using 2026 ranges.`}
  crumbs={[{ name: "Cost estimator", href: "/tools/cost-estimator/" }]}
>
  <section class="wrap head">
    <p class="eyebrow">Tool</p>
    <h1>Water damage cost estimator</h1>
    <p class="lede">A rough range for the drying and cleanup part of the job, using published 2026 per-square-foot ranges. Rebuild costs like new drywall and flooring come on top.</p>
  </section>

  <section class="wrap tool-grid">
    <form class="card tool" data-estimator onsubmit="return false">
      <fieldset>
        <legend>What kind of water?</legend>
        <label class="opt"><input type="radio" name="cat" value="1" checked /><span><strong>Clean</strong><span class="small muted">Supply line, sink, water heater, rain through a window</span></span></label>
        <label class="opt"><input type="radio" name="cat" value="2" /><span><strong>Gray</strong><span class="small muted">Washer or dishwasher discharge, toilet overflow without feces, sump</span></span></label>
        <label class="opt"><input type="radio" name="cat" value="3" /><span><strong>Black</strong><span class="small muted">Sewage, floodwater, or water that sat for days</span></span></label>
      </fieldset>
      <div class="field">
        <label for="sqft">Wet area <output id="sqft-out">300</output> sq ft</label>
        <input id="sqft" type="range" min="25" max="2500" step="25" value="300" />
        <p class="small faint">For reference: a 12 by 12 foot room is 144 sq ft. A typical basement is 700 to 1,200.</p>
      </div>
      <div class="field">
        <label class="check"><input id="afterhours" type="checkbox" /> Needs night or weekend response</label>
      </div>
    </form>

    <div class="result card" aria-live="polite">
      <p class="eyebrow">Estimated mitigation range</p>
      <p class="big" id="range">$900 – $1,200</p>
      <p class="muted" id="basis">Clean water at about $3 to $4 per square foot.</p>
      <p class="small faint" id="extra" hidden>After-hours calls can cost more. Ask for the emergency rate before work starts.</p>
      <hr />
      <ul class="small muted">
        <li>Waiting a day or more can turn clean water into gray, and raises the cost.</li>
        <li>If the cause is covered, you'd typically pay your deductible and your insurer pays the approved scope.</li>
        <li>This isn't a quote. Get a written estimate from the company that inspects.</li>
      </ul>
      <CallButton placement="estimator" block />
    </div>
  </section>

  <section class="wrap note">
    <p class="small faint">Ranges: about $3 to $4 per sq ft for clean water, $4 to $6.50 for gray water, and about $7 and up for black water, from published 2026 cost guides. See <a href={p("/guides/water-damage-restoration-cost/")}>what restoration costs</a> for sources and full-job ranges.</p>
  </section>
</Base>

<style>
  .head { padding-top: clamp(28px, 5vw, 56px); padding-bottom: 24px; }
  .tool-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 24px; align-items: start; }
  fieldset { border: 0; padding: 0; margin: 0 0 20px; }
  legend { font-weight: 600; margin-bottom: 10px; }
  .opt { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 1px solid var(--line-2); border-radius: var(--r); cursor: pointer; }
  .opt + .opt { margin-top: 8px; }
  .opt:has(input:checked) { border-color: var(--water); background: var(--water-soft); }
  .opt input { margin-top: 5px; accent-color: var(--water); }
  .opt > span { display: grid; gap: 2px; }
  .field { margin-top: 18px; }
  .field label { font-weight: 600; display: block; margin-bottom: 8px; }
  .field input[type="range"] { width: 100%; accent-color: var(--water); }
  .check { display: flex !important; gap: 10px; align-items: center; font-weight: 500 !important; }
  .check input { width: 18px; height: 18px; accent-color: var(--water); }
  .result { position: sticky; top: 88px; display: grid; gap: 4px; }
  .result p { margin: 0; }
  .big { font: 600 2.2rem/1.15 var(--serif); margin: 4px 0 6px !important; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 14px 0; width: 100%; }
  .result ul { margin: 0 0 16px; }
  .note { padding: 24px 20px 72px; }
  @media (max-width: 860px) { .tool-grid { grid-template-columns: 1fr; } .result { position: static; } }
</style>

<script>
  const RATES: Record<string, [number, number | null, string]> = {
    "1": [3, 4, "Clean water at about $3 to $4 per square foot."],
    "2": [4, 6.5, "Gray water at about $4 to $6.50 per square foot."],
    "3": [7, null, "Black water at about $7 per square foot and up, depending on how much has to be removed."],
  };
  const form = document.querySelector<HTMLFormElement>("[data-estimator]")!;
  const sqft = form.querySelector<HTMLInputElement>("#sqft")!;
  const out = form.querySelector<HTMLOutputElement>("#sqft-out")!;
  const after = form.querySelector<HTMLInputElement>("#afterhours")!;
  const range = document.getElementById("range")!;
  const basis = document.getElementById("basis")!;
  const extra = document.getElementById("extra")!;
  const usd = (n: number) => "$" + (Math.round(n / 50) * 50).toLocaleString("en-US");
  function update() {
    const cat = (form.querySelector<HTMLInputElement>("input[name=cat]:checked")!).value;
    const area = Number(sqft.value);
    const [lo, hi, text] = RATES[cat];
    out.value = area.toLocaleString("en-US");
    range.textContent = hi ? `${usd(area * lo)} – ${usd(area * hi)}` : `From ${usd(area * lo)}`;
    basis.textContent = text;
    extra.hidden = !after.checked;
  }
  form.addEventListener("input", update);
  update();
</script>
